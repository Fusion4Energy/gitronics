# The committed viewer artifact is generated by Vite (LF line endings). Pin LF so
# the CI drift check (`git diff` after `npm run build`) is deterministic across
# operating systems regardless of a contributor's `core.autocrlf` setting.
src/project_report.html text eol=lf

# Viewer sources are authored with LF for the same reason.
viewer/**/*.ts text eol=lf
viewer/**/*.svelte text eol=lf
viewer/**/*.mjs text eol=lf
viewer/**/*.css text eol=lf
viewer/**/*.json text eol=lf
viewer/**/*.html text eol=lf
